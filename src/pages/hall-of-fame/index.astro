---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import {
  loadFranchises,
  loadSeasonPodiums,
  loadMedals,
  loadRecords,
  franchiseForYear,
  activeFranchise,
} from '../../lib/hall-of-fame';

const franchises = await loadFranchises();

const [podiums, medals, records, { data: accoladeRows, error: aErr }] = await Promise.all([
  loadSeasonPodiums(franchises),
  loadMedals(),
  loadRecords(franchises, 10),
  supabase
    .schema('scdfl')
    .from('accolades')
    .select('year, award_code, award_desc, player_id, sleeper_id, transaction_id')
    .order('year', { ascending: false })
    .limit(500),
]);

if (aErr) throw new Error(`Accolades query failed: ${aErr.message}`);

const accolades = accoladeRows ?? [];

// ── Wings ─────────────────────────────────────────────────────────────────
const wings = [
  { name: 'Champions', slug: 'champions', line: 'What we all play for.', locked: false },
  { name: 'Superlatives', slug: 'superlatives', line: 'Awards for the people, by the people.', locked: false },
  { name: 'Medals', slug: 'medals', line: 'Players who reached the summit.', locked: false },
  { name: 'Records', slug: 'records', line: 'The league\'s most unforgettable moments.', locked: false },
  { name: 'Hall of Famers', slug: 'inductees', line: 'The legends of Sixth City. Coming soon.', locked: true },
];

// ── Hero counts ───────────────────────────────────────────────────────────
const seasonsComplete = podiums.length;
const franchisesCrowned = new Set(podiums.map(p => p.champion?.activeAbbr).filter(Boolean)).size;
const medalsAwarded = medals.length;
const awardsVoted = accolades.length;

// ── Recent additions ──────────────────────────────────────────────────────
const latestPodium = podiums[0] ?? null;

const latestAccoladeYear = accolades.length ? Math.max(...accolades.map(a => a.year)) : null;
const latestAccolade = latestAccoladeYear === null
  ? null
  : accolades.filter(a => a.year === latestAccoladeYear).find(a => a.award_code === 'mvp')
    ?? accolades.find(a => a.year === latestAccoladeYear)
    ?? null;

const latestMedalYear = medals.length ? Math.max(...medals.map(m => m.year)) : null;
const latestMedal = latestMedalYear === null
  ? null
  : [...medals.filter(m => m.year === latestMedalYear)].sort((a, b) => Number(b.fpts) - Number(a.fpts))[0] ?? null;
const latestMedalCount = latestMedalYear === null
  ? 0
  : medals.filter(m => m.year === latestMedalYear).length;

// Newest entry standing anywhere in either record book.
type RecordHighlight = {
  kind: 'team' | 'player';
  rank: number;
  year: number;
  week: number;
  who: string;
  detail: string;
  score: number;
};

const recordHighlights: RecordHighlight[] = [
  ...records.teamScores.map((record, i) => ({
    kind: 'team' as const,
    rank: i + 1,
    year: record.year,
    week: record.week,
    who: record.team?.name ?? '—',
    detail: `vs. ${record.opponent?.abbr ?? '—'}`,
    score: record.score,
  })),
  ...records.playerScores.map((record, i) => ({
    kind: 'player' as const,
    rank: i + 1,
    year: record.year,
    week: record.week,
    who: record.name,
    detail: `${record.position} • ${record.team?.abbr ?? '—'}`,
    score: record.points,
  })),
];

const newestRecord = recordHighlights.sort((a, b) => b.year - a.year || b.week - a.week)[0] ?? null;

// ── Names for the two people surfaced above ───────────────────────────────
const spotlightPlayerIds = [latestAccolade?.player_id, latestMedal?.player_id].filter(Boolean) as string[];

const { data: spotlightPlayers, error: pErr } = spotlightPlayerIds.length
  ? await supabase
      .schema('scdfl')
      .from('v_players')
      .select('player_id, first_name, last_name, position, team, espn_id')
      .in('player_id', spotlightPlayerIds)
  : { data: [], error: null };

if (pErr) throw new Error(`Players query failed: ${pErr.message}`);

const playerById = new Map((spotlightPlayers ?? []).map(p => [p.player_id, p]));

function playerLabel(id: string | null | undefined): string {
  if (!id) return '—';
  const p = playerById.get(id);
  return p ? `${p.first_name ?? ''} ${p.last_name ?? ''}`.trim() : id;
}

/** Manager/trade awards have no player, so resolve the franchise instead. */
function accoladeSubject(accolade: typeof accolades[number] | null): string {
  if (!accolade) return '—';
  if (accolade.player_id) return playerLabel(accolade.player_id);
  if (accolade.sleeper_id) {
    const era = franchiseForYear(franchises, accolade.sleeper_id, accolade.year);
    const active = activeFranchise(franchises, accolade.sleeper_id);
    return (era ?? active)?.name ?? '—';
  }
  return 'A multi-team trade';
}

const medalPlayerName = playerLabel(latestMedal?.player_id);

function ordinal(n: number): string {
  const suffix = n % 10 === 1 && n % 100 !== 11 ? 'st'
    : n % 10 === 2 && n % 100 !== 12 ? 'nd'
    : n % 10 === 3 && n % 100 !== 13 ? 'rd'
    : 'th';
  return `${n}${suffix}`;
}

type RecentCard = {
  wing: string;
  href: string;
  eyebrow: string;
  headline: string;
  detail: string;
  logoAbbr?: string | null;
};

const recentCards: RecentCard[] = [];

if (latestPodium?.champion) {
  recentCards.push({
    wing: 'Champions',
    href: '/hall-of-fame/champions',
    eyebrow: `${latestPodium.year} • ${latestPodium.dynastyBowlLabel}`,
    headline: latestPodium.champion.name,
    detail: latestPodium.charity
      ? `Champion • played for ${latestPodium.charity}`
      : 'Champion',
    logoAbbr: latestPodium.champion.abbr,
  });
}

if (latestAccolade) {
  recentCards.push({
    wing: 'Superlatives',
    href: '/hall-of-fame/superlatives',
    eyebrow: `${latestAccolade.year} • ${latestAccolade.award_desc}`,
    headline: accoladeSubject(latestAccolade),
    detail: `Voted by the league • ${accolades.filter(a => a.year === latestAccolade.year).length} awards that season`,
  });
}

if (latestMedal) {
  recentCards.push({
    wing: 'Medals',
    href: '/hall-of-fame/medals',
    eyebrow: `${latestMedal.year} • ${latestMedal.position} Medalist`,
    headline: medalPlayerName,
    detail: `${Number(latestMedal.fpts).toFixed(2)} pts • ${latestMedalCount} medals awarded that season`,
  });
}

if (newestRecord) {
  recentCards.push({
    wing: 'Records',
    href: '/hall-of-fame/records',
    eyebrow: `${newestRecord.year} • Week ${newestRecord.week}`,
    headline: newestRecord.who,
    detail: `${newestRecord.score.toFixed(2)} — ${ordinal(newestRecord.rank)}-highest ${newestRecord.kind === 'team' ? 'team score' : 'player score'} all-time`,
  });
}
---

<Layout
  title="Hall of Fame"
  description="The Sixth City Dynasty Hall of Fame — champions, superlatives, medals, records, and the legends of the league."
>
  <!-- Hero -->
  <section class="hof-hero" data-theme="ink">
    <div class="sc-stripe" style="height: 4px; width: 100%;" aria-hidden="true"></div>
    <div class="hof-hero-inner">
      <img src="/brand/emblem_white.svg" width="120" height="120" alt="" class="hof-hero-emblem" />
      <p class="hof-hero-eyebrow">Sixth City Dynasty</p>
      <h1 class="hof-hero-title">HALL OF FAME</h1>
      <p class="hof-hero-lede">
        A compendium of Sixth City's shared history. Everything the league has decided is worth remembering on the field, in the owners' boxes, or by the numbers.
      </p>
    </div>
  </section>

  <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">

    <!-- Wing grid: 2-2-1 -->
    <div class="wing-grid">
      {wings.map(wing => {
        // A locked wing renders as a plain tile — styled as anticipated and
        // with no link, since its page is not open to visitors yet.
        const Tag = wing.locked ? 'div' : 'a';
        return (
          <Tag
            href={wing.locked ? undefined : `/hall-of-fame/${wing.slug}`}
            class={`wing-tile${wing.locked ? ' is-locked' : ''}`}
          >
            <div class="wing-tile-inner">
              <span class="wing-hex sc-hex" aria-hidden="true"></span>
              <h2 class="wing-name">{wing.name}</h2>
              <p class="wing-line">{wing.line}</p>
              {wing.locked && <span class="wing-badge">Not Yet Open</span>}
            </div>
          </Tag>
        );
      })}
    </div>

    <!-- Recent additions -->
    {recentCards.length > 0 && (
      <section class="recent">
        <div class="recent-head">
          <h2 class="recent-title">Recent Additions</h2>
          <p class="recent-sub">The newest entry in each wing.</p>
        </div>
        <div class="recent-grid">
          {recentCards.map(card => (
            <a href={card.href} class="recent-card">
              <p class="recent-wing">{card.wing}</p>
              <p class="recent-eyebrow">{card.eyebrow}</p>
              <div class="recent-headline-row">
                {card.logoAbbr && (
                  <img
                    src={`/images/logos/${card.logoAbbr}.png`}
                    alt=""
                    width="32"
                    height="32"
                    style="object-fit: contain; flex-shrink: 0;"
                    onerror="this.style.display='none'"
                  />
                )}
                <h3 class="recent-headline">{card.headline}</h3>
              </div>
              <p class="recent-detail">{card.detail}</p>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  /* ---- Hero — broadcast band ---- */
  .hof-hero {
    background-color: var(--surface-ink);
    color: var(--text-strong);
    margin-bottom: 3.5rem;
  }
  .hof-hero-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 1.5rem 3rem;
    text-align: center;
  }
  .hof-hero-emblem { display: block; margin: 0 auto 1.25rem; }

  .hof-hero-eyebrow {
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold-400);
    margin: 0 0 0.6rem;
  }

  .hof-hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 8rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-strong);
    margin: 0;
  }

  .hof-hero-lede {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: var(--lh-relaxed);
    color: var(--text-body);
    max-width: 56ch;
    margin: 1rem auto 0;
  }

  /* ---- Wing grid: two rows of two, then one full width ---- */
  .wing-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background-color: var(--border-default);
    border: 1px solid var(--border-default);
  }
  .wing-grid > *:nth-child(5) { grid-column: 1 / -1; }

  .wing-tile {
    background-color: var(--surface-card);
    display: block;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .wing-tile:hover { text-decoration: none; background-color: var(--gold-100); }

  .wing-tile-inner {
    padding: 2.75rem 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    border-top: 3px solid transparent;
    transition: border-color var(--dur-fast) var(--ease-standard);
  }
  .wing-tile:hover .wing-tile-inner { border-top-color: var(--ember-500); }

  .wing-hex {
    width: 22px;
    background-color: var(--gold-500);
    margin-bottom: 0.4rem;
    transition: background-color var(--dur-fast) var(--ease-standard);
  }
  .wing-tile:hover .wing-hex { background-color: var(--ember-500); }

  .wing-name {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--text-strong);
    margin: 0;
  }

  .wing-line {
    font-family: var(--font-serif);
    font-size: 0.95rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* Locked wing reads as anticipated, not broken — and is inert, so it drops
     every hover affordance that would suggest it goes somewhere. */
  .wing-tile.is-locked { background-color: var(--surface-sunken); cursor: default; }
  .wing-tile.is-locked:hover { background-color: var(--surface-sunken); }
  .wing-tile.is-locked .wing-name { color: var(--color-text-muted); }
  .wing-tile.is-locked .wing-hex { background-color: var(--ink-300); }
  .wing-tile.is-locked:hover .wing-hex { background-color: var(--ink-300); }
  .wing-tile.is-locked:hover .wing-tile-inner { border-top-color: transparent; }

  .wing-badge {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-500);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-pill);
    padding: 0.25rem 0.7rem;
    margin-top: 0.35rem;
  }

  /* ---- Recent additions ---- */
  .recent { margin-top: 4rem; margin-bottom: 5rem; }

  .recent-head {
    border-bottom: 2px solid var(--rule-ink);
    padding-bottom: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .recent-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-strong);
  }
  .recent-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0.3rem 0 0;
  }

  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .recent-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-left: 3px solid var(--gold-500);
    box-shadow: var(--shadow-1);
    padding: 1.35rem 1.5rem;
    text-decoration: none;
    display: block;
    transition: border-color var(--dur-fast) var(--ease-standard),
                box-shadow var(--dur-base) var(--ease-standard),
                transform var(--dur-base) var(--ease-felt);
  }
  .recent-card:hover {
    text-decoration: none;
    border-color: var(--border-default);
    border-left-color: var(--ember-500);
    box-shadow: var(--shadow-3);
    transform: translateY(-1px);
  }

  .recent-wing {
    font-family: var(--font-sans);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ember-700);
    margin: 0 0 0.75rem;
  }

  .recent-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.35rem;
  }

  .recent-headline-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .recent-headline {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.15;
    color: var(--text-strong);
    margin: 0;
  }

  .recent-detail {
    font-family: var(--font-body);
    font-size: 0.78rem;
    color: var(--color-text-muted);
    margin: 0.5rem 0 0;
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .hof-hero { margin-bottom: 2.5rem; }
    .hof-hero-inner { padding: 2.5rem 1.5rem 2.25rem; }

    .wing-grid { grid-template-columns: 1fr !important; }
    .wing-grid > *:nth-child(5) { grid-column: auto !important; }
    .wing-tile-inner { padding: 1.75rem 1.25rem; }
    .wing-name { font-size: 1.6rem; }

    .recent-grid { grid-template-columns: 1fr !important; }
  }
</style>
