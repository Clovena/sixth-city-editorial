---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import {
  loadFranchises,
  loadMedals,
  franchiseForYear,
  activeFranchise,
  MEDAL_POSITION_ORDER,
  MEDAL_POSITION_COLOR,
} from '../../lib/hall-of-fame';

const [franchises, medals] = await Promise.all([loadFranchises(), loadMedals()]);

const { data: playerRows, error: pErr } = await supabase
  .schema('scdfl')
  .from('v_players')
  .select('player_id, first_name, last_name, position, team, espn_id')
  .in('player_id', [...new Set(medals.map(m => m.player_id))]);

if (pErr) throw new Error(`Players query failed: ${pErr.message}`);

const playerById = new Map((playerRows ?? []).map(p => [p.player_id, p]));

// ── One card per position, each a year-by-year timeline ───────────────────
// Same shape the Superlatives timelines use: the card is the constant (a
// position / an award) and each season appends another row inside it.
type MedalWin = {
  year: number;
  playerId: string;
  name: string;
  espnId: string | null;
  fpts: number;
  gamesStarted: number;
  /** Identity as branded that season — drives the logo */
  abbr: string | null;
  /** Current identity — drives the /franchises link */
  activeAbbr: string | null;
};

type PositionTimeline = {
  position: string;
  wins: MedalWin[];
};

const byPosition = new Map<string, PositionTimeline>();

for (const medal of medals) {
  const player = playerById.get(medal.player_id);
  const era = franchiseForYear(franchises, medal.sleeper_id, medal.year);
  const active = activeFranchise(franchises, medal.sleeper_id);

  let timeline = byPosition.get(medal.position);
  if (!timeline) {
    timeline = { position: medal.position, wins: [] };
    byPosition.set(medal.position, timeline);
  }

  timeline.wins.push({
    year: medal.year,
    playerId: medal.player_id,
    name: player ? `${player.first_name ?? ''} ${player.last_name ?? ''}`.trim() : medal.player_id,
    espnId: player?.espn_id ?? null,
    fpts: Number(medal.fpts),
    gamesStarted: Number(medal.games_started),
    abbr: era?.abbr ?? active?.abbr ?? null,
    activeAbbr: active?.abbr ?? era?.abbr ?? null,
  });
}

for (const timeline of byPosition.values()) {
  timeline.wins.sort((a, b) => b.year - a.year);
}

const timelineFor = (position: string) => byPosition.get(position) ?? null;

// Offense on top, kicker and the three IDP groups below — the defensive cards
// start in 2022, so they read better as their own band than mixed into the grid.
const OFFENSE_POSITIONS = ['QB', 'RB', 'WR', 'TE'];
const DEFENSE_POSITIONS = MEDAL_POSITION_ORDER.filter(p => !OFFENSE_POSITIONS.includes(p));

const POSITION_NAME: Record<string, string> = {
  QB: 'Quarterback',
  RB: 'Running Back',
  WR: 'Wide Receiver',
  TE: 'Tight End',
  K: 'Kicker',
  DL: 'Defensive Line',
  LB: 'Linebacker',
  DB: 'Defensive Back',
};

// ── Season context ────────────────────────────────────────────────────────
const medalYears = [...new Set(medals.map(m => m.year))].sort();
const firstYear = medalYears[0];
const latestYear = medalYears[medalYears.length - 1];
const idpFirstYear = Math.min(
  ...medals.filter(m => ['DL', 'LB', 'DB'].includes(m.position)).map(m => m.year),
);

const sections = [
  {
    title: 'Offense',
    sub: `Awarded every season since ${firstYear}`,
    cards: OFFENSE_POSITIONS.map(timelineFor).filter(Boolean) as PositionTimeline[],
  },
  {
    title: 'Kicker & Defense',
    sub: `Defensive medals begin in ${idpFirstYear}, when IDP slots entered the league`,
    cards: DEFENSE_POSITIONS.map(timelineFor).filter(Boolean) as PositionTimeline[],
  },
].filter(section => section.cards.length > 0);

const careerCounts = new Map<string, number>();
for (const medal of medals) {
  careerCounts.set(medal.player_id, (careerCounts.get(medal.player_id) ?? 0) + 1);
}
const repeatMedalists = [...careerCounts.values()].filter(count => count > 1).length;

const positionsInPlay = MEDAL_POSITION_ORDER.filter(p => byPosition.has(p));

const fmtPoints = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
---

<Layout
  title="Medals"
  description="The Sixth City Dynasty medal wing — every player who has led their position in scoring across a season, listed by position and year."
>
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem;">

    <!-- Page header -->
    <div style="border-bottom: 1px solid var(--color-border); padding: 3rem 0 2.5rem; margin-top: 3rem;">
      <a href="/hall-of-fame" class="hof-back">&#8592; Hall of Fame</a>
      <p class="section-label" style="margin-top: 1.25rem;">Players Who Reached The Stars</p>
      <h1 class="page-title">Medals</h1>
      <p class="page-subtitle" style="margin-top: 0.75rem;">
        A medal goes to the player who scores the most fantasy points at their
        position across a regular season, counted only from the weeks they were
        started in Sixth City. One medal per position per season.
      </p>
    </div>

    <!-- Position cards -->
    {sections.map(section => (
      <section class="medal-section">
        <div class="medal-section-head">
          <h2 class="medal-section-title">{section.title}</h2>
          <p class="medal-section-sub">{section.sub}</p>
        </div>
        <div class="medal-grid">
          {section.cards.map(card => (
            <article
              class="medal-card"
              style={`--accent: var(--color-${MEDAL_POSITION_COLOR[card.position] ?? 'grey'}-glow);
                      --accent-surface: var(--color-${MEDAL_POSITION_COLOR[card.position] ?? 'grey'}-surface);`}
            >
              <div class="medal-card-head">
                <span class="pos-chip">{card.position}</span>
                <h3 class="medal-position-name">{POSITION_NAME[card.position] ?? card.position}</h3>
              </div>
              <ol class="timeline">
                {card.wins.map(win => (
                  <li class="timeline-row">
                    <span class="timeline-year sc-tabular">{win.year}</span>
                    <span class="timeline-body">
                      <img
                        src={win.espnId
                          ? `https://a.espncdn.com/i/headshots/nfl/players/full/${win.espnId}.png`
                          : '/images/player-placeholder.png'}
                        alt=""
                        width="40"
                        height="40"
                        loading="lazy"
                        decoding="async"
                        class="headshot"
                        onerror="this.src='/images/player-placeholder.png';this.onerror=null;"
                      />
                      <span class="timeline-names">
                        <a href={`/players/${win.playerId}`} class="winner-name">{win.name}</a>
                        <span class="winner-meta">
                          <span class="sc-tabular">{fmtPoints(win.fpts)}</span> pts &bull;
                          {' '}<span class="sc-tabular">{win.gamesStarted}</span> starts
                        </span>
                      </span>
                    </span>
                    {win.abbr && (
                      <a
                        href={`/franchises/${win.activeAbbr}`}
                        class="timeline-team"
                        title={`Started by ${win.abbr}`}
                      >
                        <img
                          src={`/images/logos/${win.abbr}.png`}
                          alt={win.abbr}
                          width="26"
                          height="26"
                          loading="lazy"
                          decoding="async"
                          onerror="this.style.display='none'"
                        />
                      </a>
                    )}
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </section>
    ))}

    <!-- How medals work -->
    <section class="explainer">
      <h2 class="explainer-title">How Medals Are Won</h2>
      <div class="explainer-grid">
        <div class="explainer-cell">
          <p class="foot-label">The Count</p>
          <p class="explainer-text">
            Only regular-season weeks count. A player's medal total is the sum
            of points they scored in the weeks a Sixth City franchise actually
            started them &mdash; bench weeks and the postseason are excluded.
          </p>
        </div>
        <div class="explainer-cell">
          <p class="foot-label">Positions Contested</p>
          <p class="explainer-text">
            {positionsInPlay.join(' · ')}. Defensive medals
            (DL, LB, DB) begin in {idpFirstYear}, when IDP slots entered the
            league &mdash; {firstYear} contested offensive positions and kicker only.
          </p>
        </div>
        <div class="explainer-cell">
          <p class="foot-label">One Winner</p>
          <p class="explainer-text">
            There is no silver or bronze. Each position produces exactly one
            medalist per season, which makes a second medal genuinely rare
            &mdash; only {repeatMedalists} players have ever earned one.
          </p>
        </div>
      </div>
    </section>

    <p class="page-whisper hof-footnote">
      {firstYear}&ndash;{latestYear}. Every medal a player has won also appears
      on their individual profile &mdash; click through any name above for full
      career stats.
    </p>
  </div>
</Layout>

<style>
  .hof-back {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .hof-back:hover { color: var(--color-text-primary); text-decoration: none; }

  /* ---- Sections ---- */
  .medal-section { margin-top: 3.5rem; }

  .medal-section-head {
    border-bottom: 2px solid var(--rule-ink);
    padding-bottom: 0.75rem;
    margin-bottom: 1.75rem;
  }
  .medal-section-title {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 700;
    margin: 0;
    color: var(--text-strong);
  }
  .medal-section-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0.3rem 0 0;
  }

  /* ---- Position cards ---- */
  .medal-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    align-items: start;
  }

  .medal-card {
    background-color: var(--surface-card);
    border: 1px solid var(--border-hairline);
    border-top: 3px solid var(--accent);
    box-shadow: var(--shadow-1);
    display: flex;
    flex-direction: column;
  }

  .medal-card-head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.1rem 1.25rem 0.9rem;
    background-color: var(--accent-surface);
    border-bottom: 1px solid var(--border-hairline);
  }

  .pos-chip {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 0.3rem 0.5rem;
    border: 1px solid var(--accent);
    background-color: var(--surface-card);
    color: var(--text-strong);
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  .medal-position-name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.15;
    margin: 0;
    color: var(--text-strong);
  }

  /* ---- Timeline ---- */
  .timeline { list-style: none; margin: 0; padding: 0; }

  .timeline-row {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-hairline);
  }
  .timeline-row:last-child { border-bottom: none; }

  .timeline-year {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 900;
    color: var(--color-text-muted);
    flex-shrink: 0;
    min-width: 2.6rem;
  }

  .timeline-body {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }
  .timeline-names { min-width: 0; }

  .headshot {
    object-fit: cover;
    border-radius: 50%;
    background-color: var(--surface-sunken);
    flex-shrink: 0;
  }

  .timeline-team {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    opacity: 0.85;
  }
  .timeline-team:hover { opacity: 1; }
  .timeline-team img { object-fit: contain; }

  .winner-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-strong);
  }
  .winner-name:hover { color: var(--ember-700); }

  .winner-meta {
    display: block;
    font-family: var(--font-body);
    font-size: 0.72rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* ---- Explainer ---- */
  .explainer { margin-top: 3.5rem; }
  .explainer-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 1.25rem;
  }
  .explainer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .explainer-cell {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--gold-500);
    padding: 1.5rem;
  }
  .foot-label {
    font-family: var(--font-body);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
  }
  .explainer-text {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .hof-footnote {
    font-size: 0.85rem;
    max-width: 70ch;
    margin: 2.5rem 0 5rem;
  }

  @media (max-width: 900px) {
    .medal-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .medal-grid { grid-template-columns: 1fr !important; }
    .explainer-grid { grid-template-columns: 1fr !important; }
    .timeline-row { padding: 0.85rem 1rem; }
  }
</style>
