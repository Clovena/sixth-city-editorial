---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import { loadFranchises, franchiseForYear, primaryColor, logoPath } from '../../lib/franchise-identity';

// ── Fetch projections (latest year) ────────────────────────────────────────
const { data: projRows, error: pErr } = await supabase
  .schema('scdfl')
  .from('projections')
  .select('sleeper_id, year, playoffs, not_playoffs, playoff_line, not_playoff_line, win_ou, win_line, conf_odds, conf_line')
  .order('year', { ascending: false })
  .limit(500);

if (pErr || !projRows) throw new Error(`Projections query failed: ${pErr?.message || 'No data returned'}`);

const currentYear = projRows[0].year;
const projections = projRows.filter(p => p.year === currentYear);

// ── Fetch all franchise identities, resolve the one active for this year ───
const franchises = await loadFranchises();

type BetRow = {
  abbr: string;
  name: string;
  conf: string;
  color: string;
  winOu: number | null;
  winLine: number | null;
  playoffLine: number | null;
  notPlayoffLine: number | null;
  playoffs: number | null;
  confLine: number | null;
  confOdds: number | null;
};

const rows: BetRow[] = projections.flatMap(p => {
  const f = franchiseForYear(franchises, String(p.sleeper_id), currentYear);
  if (!f) return [];
  return [{
    abbr: f.abbr,
    name: f.name,
    conf: f.conf,
    color: primaryColor(f.colors),
    winOu: p.win_ou,
    winLine: p.win_line,
    playoffLine: p.playoff_line,
    notPlayoffLine: p.not_playoff_line,
    playoffs: p.playoffs,
    confLine: p.conf_line,
    confOdds: p.conf_odds,
  }];
});

// ── Sorting per market ─────────────────────────────────────────────────────
const winRows = [...rows]
  .filter(r => r.winOu !== null)
  .sort((a, b) => (b.winOu! - a.winOu!) || a.abbr.localeCompare(b.abbr));

const playoffRows = [...rows]
  .filter(r => r.playoffLine !== null)
  .sort((a, b) => (b.playoffs ?? 0) - (a.playoffs ?? 0) || a.abbr.localeCompare(b.abbr));

const confRows = [...rows]
  .filter(r => r.confLine !== null)
  .sort((a, b) => (b.confOdds ?? 0) - (a.confOdds ?? 0) || a.abbr.localeCompare(b.abbr));

const sccConfRows = confRows.filter(r => r.conf === 'SCC');
const hccConfRows = confRows.filter(r => r.conf === 'HCC');

// ── American odds formatter ────────────────────────────────────────────────
function odds(n: number | null): string {
  if (n === null || n === undefined) return '—';
  return n > 0 ? `+${n}` : `${n}`;
}

// Half-point lines render as "10.5"; whole numbers keep a trailing .0 off
function line(n: number | null): string {
  if (n === null || n === undefined) return '—';
  return String(n);
}
---

<Layout title="Bets" description={`Win totals, playoff odds, and conference title futures for the ${currentYear} Sixth City Dynasty Football League season.`}>

  <div style="max-width: 1200px; margin: 0 auto; padding: 4rem 1.5rem 0;">

    <!-- Page header -->
    <div>
      <p class="section-label">Game Lines and Futures</p>
      <h1 class="page-title">Bets</h1>
      <p class="page-subtitle" style="margin-top: 0.75rem;">
        The {currentYear} board, priced off simulated season outcomes. Win totals,
        playoff qualification, and conference title futures for all fourteen
        franchises. Lines are posted for reading, not for taking action (yet).
      </p>
    </div>
    <hr style="margin: 2.5rem 0 0;" />

    <!-- Market tabs -->
    <div class="bet-tabs" role="tablist" aria-label="Betting markets">
      <button class="bet-tab is-active" role="tab" aria-selected="true" data-market="wins">Win Totals</button>
      <button class="bet-tab" role="tab" aria-selected="false" data-market="playoffs">Playoff Odds</button>
      <button class="bet-tab" role="tab" aria-selected="false" data-market="conference">Conference Titles</button>
    </div>

    <div style="padding-bottom: 5rem;">

      <!-- ── Win totals ─────────────────────────────────────────────────── -->
      <section class="bet-panel" data-panel="wins">
        <div class="board">
          <div class="board-head board-head-wins">
            <span class="board-head-team"></span>
            <span class="board-head-cell">Wins</span>
            <span class="board-head-cell">Over</span>
            <span class="board-head-cell">Under</span>
          </div>
          {winRows.map(r => (
            <div class="board-row board-row-wins" style={`--team-color: ${r.color};`}>
              <a class="board-team" href={`/franchises/${r.abbr}`}>
                <img src={logoPath(r.abbr)} alt="" width="28" height="28" class="board-logo" onerror="this.style.display='none'" />
                <span class="board-abbr">{r.abbr}</span>
                <span class="board-name">{r.name}</span>
              </a>
              <div class="wins-callout">{line(r.winOu)}</div>
              <div class="odds-cell">
                <span class="odds-price">{odds(r.winLine)}</span>
              </div>
              <div class="odds-cell">
                <span class="odds-price">{odds(r.winLine)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Playoff odds ───────────────────────────────────────────────── -->
      <section class="bet-panel" data-panel="playoffs" hidden>
        <div class="board">
          <div class="board-head board-head-two">
            <span class="board-head-team">To Make the {currentYear} Playoffs</span>
            <span class="board-head-cell">Yes</span>
            <span class="board-head-cell">No</span>
          </div>
          {playoffRows.map(r => (
            <div class="board-row board-row-two" style={`--team-color: ${r.color};`}>
              <a class="board-team" href={`/franchises/${r.abbr}`}>
                <img src={logoPath(r.abbr)} alt="" width="28" height="28" class="board-logo" onerror="this.style.display='none'" />
                <span class="board-abbr">{r.abbr}</span>
                <span class="board-name">{r.name}</span>
              </a>
              <div class="odds-cell">
                <span class="odds-price">{odds(r.playoffLine)}</span>
              </div>
              <div class="odds-cell">
                <span class="odds-price">{odds(r.notPlayoffLine)}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ── Conference titles ──────────────────────────────────────────── -->
      <section class="bet-panel" data-panel="conference" hidden>
        <div class="conf-grid">
          {[
            { label: 'Senatorial Canadian Conference', rows: sccConfRows },
            { label: 'House of Commons Conference', rows: hccConfRows },
          ].map(group => (
            <div class="board">
              <div class="board-head board-head-conf">
                <span class="board-head-team">{group.label}</span>
                <span class="board-head-cell">To Win</span>
              </div>
              {group.rows.map(r => (
                <div class="board-row board-row-conf" style={`--team-color: ${r.color};`}>
                  <a class="board-team" href={`/franchises/${r.abbr}`}>
                    <img src={logoPath(r.abbr)} alt="" width="28" height="28" class="board-logo" onerror="this.style.display='none'" />
                    <span class="board-abbr">{r.abbr}</span>
                    <span class="board-name">{r.name}</span>
                  </a>
                  <div class="odds-cell">
                    <span class="odds-price">{odds(r.confLine)}</span>
                  </div>
                </div>
              ))}
            </div>
          ))}
        </div>
      </section>

    </div>

  </div>

</Layout>

<style>
  /* ---- Tabs ---- */
  .bet-tabs {
    display: flex;
    gap: 0;
    margin: 0 0 2rem;
    border-bottom: 1px solid var(--border-default);
    overflow-x: auto;
    overflow-y: hidden;
    scrollbar-width: none;
  }

  .bet-tabs::-webkit-scrollbar { display: none; }

  .bet-tab {
    font-family: var(--font-sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.9rem 1.25rem;
    margin-bottom: -1px;
    cursor: pointer;
    white-space: nowrap;
    transition: color var(--dur-fast) var(--ease-standard),
                border-color var(--dur-fast) var(--ease-standard);
  }

  .bet-tab:hover { color: var(--text-strong); }

  .bet-tab.is-active {
    color: var(--text-strong);
    border-bottom-color: var(--ember-500);
  }

  /* ---- Board ---- */
  .board {
    background-color: var(--surface-card);
    border: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-1);
  }

  .board + .board { margin-top: 2rem; }

  .board-head {
    display: grid;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background-color: var(--surface-sunken);
    border-bottom: 1px solid var(--border-default);
  }

  .board-head-wins { grid-template-columns: 1fr 5rem 7.5rem 7.5rem; }
  .board-head-two  { grid-template-columns: 1fr 7.5rem 7.5rem; }
  .board-head-conf { grid-template-columns: 1fr 7.5rem; }

  .board-head-team,
  .board-head-cell {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate-600);
  }

  .board-head-cell { text-align: center; }

  .board-row {
    display: grid;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 1rem;
    border-left: 3px solid var(--team-color);
  }

  .board-row + .board-row { border-top: 1px solid var(--border-hairline); }
  .board-row:hover { background-color: var(--surface-sunken); }

  .board-row-wins { grid-template-columns: 1fr 5rem 7.5rem 7.5rem; }
  .board-row-two  { grid-template-columns: 1fr 7.5rem 7.5rem; }
  .board-row-conf { grid-template-columns: 1fr 7.5rem; }

  /* ---- Win total callout ---- */
  .wins-callout {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.01em;
    text-align: center;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }

  .board-team {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    text-decoration: none;
    color: inherit;
  }

  .board-team:hover { text-decoration: none; }
  .board-team:hover .board-abbr { color: var(--ember-600); }
  .board-team:hover .board-name { color: var(--text-strong); }

  .board-logo { object-fit: contain; flex-shrink: 0; }

  .board-abbr {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-strong);
    flex-shrink: 0;
    min-width: 3.2rem;
  }

  .board-name {
    font-family: var(--font-serif);
    font-size: 0.88rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ---- Odds "buttons" ---- */
  .odds-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    padding: 0.4rem 0.5rem;
    min-height: 2.6rem;
    background-color: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
  }

  .odds-price {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--ember-600);
    font-variant-numeric: tabular-nums;
  }

  /* ---- Conference layout ---- */
  .conf-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .conf-grid .board + .board { margin-top: 0; }

  @media (max-width: 900px) {
    .conf-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 768px) {
    .board-name { display: none; }

    .board-team {
      flex-direction: column;
      gap: 0.2rem;
    }

    .board-logo { width: 22px; height: 22px; }

    .board-abbr { min-width: 0; }

    .board-head-wins,
    .board-row-wins { grid-template-columns: 1fr 3rem 5.5rem 5.5rem; }
    .board-head-two,
    .board-row-two { grid-template-columns: 1fr 5.5rem 5.5rem; }
    .board-head-conf,
    .board-row-conf { grid-template-columns: 1fr 5.5rem; }
    .wins-callout { font-size: 1.4rem; }
    .bet-tab { padding: 0.85rem 0.85rem; font-size: 0.68rem; }
  }

  @media (max-width: 360px) {
    .board-logo { display: none; }
  }
</style>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.bet-tab');
  const panels = document.querySelectorAll<HTMLElement>('.bet-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      const market = tab.dataset.market;

      tabs.forEach(t => {
        const active = t === tab;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });

      panels.forEach(p => {
        p.hidden = p.dataset.panel !== market;
      });
    });
  });
</script>
